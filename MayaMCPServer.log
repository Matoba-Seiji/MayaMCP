         '\n'
         'def short(n):\n'
         "    return n.rsplit('|', 1)[-1]\n"
         '\n'
         'def descendants(root):\n'
         '    out=[root]\n'
         "    kids=cmds.listRelatives(root, ad=True, type='transform', "
         'fullPath=True) or []\n'
         '    # listRelatives(ad) is grandchild-first; sort by path depth for '
         'readable parent-before-child\n'
         "    kids=sorted(kids, key=lambda x: x.count('|'))\n"
