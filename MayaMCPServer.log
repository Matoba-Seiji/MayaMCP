         "out['parent_same_0_end']=[round(p0[i]-pE[i],3) for i in range(3)]\n"
         '# parent local rot at 0 vs end\n'
         'def lrot(node,f):\n'
         '    cmds.currentTime(f)\n'
         '    return '
         "[round(cmds.getAttr(node+'.rx'),2),round(cmds.getAttr(node+'.ry'),2),round(cmds.getAttr(node+'.rz'),2)]\n"
         "out['parent_lrot_0']=lrot(parent_full,0)\n"
         "out['parent_lrot_end']=lrot(parent_full,mx)\n"
         'cmds.currentTime(cur)\n'
         'result=out'}

