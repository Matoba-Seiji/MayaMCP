         '\n'
         'def world_pos_rot(node,f):\n'
         '    sel=om.MSelectionList(); sel.add(node); dag=sel.getDagPath(0)\n'
         '    cmds.currentTime(f)\n'
         '    mm=dag.inclusiveMatrix()\n'
         '    t=[round(mm[12],3),round(mm[13],3),round(mm[14],3)]\n'
         '    return t\n'
         '# compare parent world pos at 0 vs mx\n'
         'cur=cmds.currentTime(q=True)\n'
         'p0=world_pos_rot(parent_full,0)\n'
